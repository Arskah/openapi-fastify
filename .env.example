HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

AWS_REGION=eu-north-1
# DynamoDB Local ignores credentials but the SDK still requires some
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
TODOS_TABLE=todos
PROJECTS_TABLE=projects

# Feature flags: without a Statsig server secret, gates are off and values use their defaults
# STATSIG_SERVER_SECRET=secret-...
# STATSIG_ENVIRONMENT=development
