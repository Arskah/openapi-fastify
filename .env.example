HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

AWS_REGION=eu-north-1
# DynamoDB Local ignores credentials but the SDK still requires some
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
TODOS_TABLE=todos
PROJECTS_TABLE=projects

# Feature flags: without a Statsig key, gates are off and values use their defaults.
# The key itself is a secret: STATSIG_SECRET_ID names it in the secret store, which in the demo is
# a local JSON file standing in for AWS Secrets Manager (copy .secrets.example.json to .secrets.json).
# Paths are relative to the app's directory (apps/<app>), where its scripts run.
# SECRETS_FILE=../../.secrets.json
# STATSIG_SECRET_ID=demo/statsig-server-key
# STATSIG_ENVIRONMENT=development
