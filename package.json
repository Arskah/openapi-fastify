{
  "name": "openapi-fastify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:init && pnpm dev:server",
    "dev:server": "pnpm --filter @demo/server dev",
    "db:up": "docker compose up -d",
    "db:init": "pnpm --filter @demo/common db:init",
    "generate": "pnpm --filter @demo/server openapi && pnpm --filter @demo/cli generate",
    "cli": "pnpm --filter @demo/cli --silent start",
    "typecheck": "tsc -p packages/common && tsc -p apps/server && tsc -p apps/cli",
    "lint:deps": "depcruise packages/common/src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:deps"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "typescript": "7.0.2"
  }
}
