{
  "name": "openapi-fastify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:up && pnpm db:init && pnpm dev:server",
    "dev:server": "pnpm --filter @demo/server dev",
    "db:up": "docker compose up -d",
    "db:init": "pnpm --filter @demo/common db:init",
    "generate": "pnpm --filter @demo/server openapi && pnpm --filter @demo/api-client generate",
    "cli": "pnpm --filter @demo/cli --silent start",
    "lambda:invoke": "pnpm --filter @demo/lambda --silent invoke",
    "typecheck": "tsc -p packages/common && tsc -p packages/api-client && tsc -p apps/server && tsc -p apps/cli && tsc -p apps/lambda",
    "lint:deps": "depcruise packages/common/src --config .dependency-cruiser.cjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm lint:deps"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
